# BUBBLE SITE - Configuration Apache pour bubble-site.fr
# Redirection de index.html vers accueil.html

RewriteEngine On

# Rediriger index.html vers accueil.html
RewriteRule ^index\.html$ /accueil.html [R=301,L]

# Rediriger la racine vers accueil.html
RewriteRule ^$ /accueil.html [R=301,L]

# Cache des ressources statiques
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Compression GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# Protection contre le hotlinking
RewriteCond %{HTTP_REFERER} !^https://(www\.)?bubble-site\.fr/ [NC]
RewriteCond %{HTTP_REFERER} !^https://(www\.)?bubble-site\.fr$ [NC]
RewriteCond %{HTTP_REFERER} !^$
RewriteRule \.(jpg|jpeg|png|gif|webp|css|js)$ - [NC,F,L]

# Sécurité - Désactiver l'affichage du contenu des dossiers
Options -Indexes

# Type MIME pour les polices
<IfModule mod_mime.c>
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    AddType application/vnd.ms-fontobject .eot
    AddType application/x-font-ttf .ttf
</IfModule>

# En-têtes de sécurité
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
