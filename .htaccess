# BUBBLE SITE - Configuration Apache pour bubble-site.fr
# ===================================================================

RewriteEngine On

# ===================================================================
# REDIRECTIONS
# ===================================================================

# Rediriger index.html vers accueil (sans .html)
RewriteRule ^index\.html$ /accueil [R=301,L]

# Rediriger la racine vers accueil (sans .html)
RewriteRule ^$ /accueil [R=301,L]

# ===================================================================
# MODE MAINTENANCE (UNIQUEMENT SUR BUBBLE-SITE.FR)
# ===================================================================

# Si le fichier maintenance.html existe ET que nous sommes sur bubble-site.fr
# ET que la requête ne vient pas de github.io (pour toi)
RewriteCond %{HTTP_HOST} ^(www\.)?bubble-site\.fr$ [NC]
RewriteCond %{DOCUMENT_ROOT}/maintenance.html -f
RewriteCond %{HTTP_REFERER} !github\.io [NC]
RewriteCond %{REQUEST_URI} !^/maintenance\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/(js|css|img|cartes|scans|vlog|img_chests|img_profile)/ [NC]
RewriteRule ^(.*)$ /maintenance.html [R=307,L]

# ===================================================================
# CACHE ET OPTIMISATIONS
# ===================================================================

<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ===================================================================
# COMPRESSION
# ===================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
</IfModule>

# ===================================================================
# SÉCURITÉ
# ===================================================================

# Désactiver l'affichage du contenu des dossiers
Options -Indexes

# Protection contre le hotlinking
RewriteCond %{HTTP_REFERER} !^https://(www\.)?bubble-site\.fr/ [NC]
RewriteCond %{HTTP_REFERER} !^https://(www\.)?bubble-site\.fr$ [NC]
RewriteCond %{HTTP_REFERER} !^$
RewriteRule \.(jpg|jpeg|png|gif|webp|css|js)$ - [NC,F,L]

# En-têtes de sécurité
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ===================================================================
# TYPES MIME
# ===================================================================

<IfModule mod_mime.c>
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    AddType application/vnd.ms-fontobject .eot
    AddType application/x-font-ttf .ttf
</IfModule>
